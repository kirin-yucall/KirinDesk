# Rust / Cargo 构建产物
/target/

# 前端 node 依赖与构建产物(由 package.json + package-lock.json 还原)
ui/frontend/node_modules/
ui/frontend/dist/

# FFmpeg 二进制发行包(可由 ffmpeg/bin/download.ps1 重新下载)
ffmpeg/ffmpeg-8.1.2-full_build-shared/
release/ffmpeg/

# 编译产物与发布临时文件
# 注意:release/KirinDesk.exe 是发布用的正式二进制,需要入库跟踪
release/*.exe.bak-*
release/bench_results*.json

# 日志与临时文件
*.log
*.tmp
*.bak

# 系统文件
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# S-28 (F-33): 发布二进制移出版控 —— 发布走 CI artifacts（GitHub Releases + checksums.txt），本地保留文件供 install.bat 使用
release/KirinDesk.exe
